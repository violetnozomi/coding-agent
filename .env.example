# ============================================================
# NZ-Coder 配置
# 复制为 .env 并填入你的实际配置
# ============================================================

# API Key (必填)
API_KEY=sk-xxx

# 模型 ID (必填)
MODEL_ID=deepseek-v4-flash

# API Base URL (必填，OpenAI 兼容接口)
API_BASE_URL=https://api.deepseek.com

# 模型 Provider 适配器
# 原生适配器: anthropic / gemini
# OpenAI-compatible 命名实例包括 openai / dashscope / deepseek / kimi /
# openrouter / groq / mistral / together / xai 等；均复用 API_BASE_URL。
MODEL_PROVIDER=openai-compatible
# Optional exact provider/model records and selected reasoning mode.
# MODEL_CATALOG_JSON={"models":{"openai-compatible/custom-model":{"context_tokens":128000,"output_tokens":32000,"supports_reasoning":true,"variants":{"low":{"reasoning_effort":"low"},"high":{"reasoning_effort":"high"}}}}}
# MODEL_CATALOG_PATH=.nz-coder/models.json
# MODEL_VARIANT=high
# Provider recovery owns one streaming attempt ladder. Buffered fallback is
# allowed only once before any stable text/tool boundary.
# NZ_PROVIDER_MAX_RETRIES=3
# NZ_PROVIDER_HARD_TIMEOUT_SECONDS=600
# NZ_PROVIDER_STREAM_IDLE_TIMEOUT_SECONDS=60
# NZ_PROVIDER_NON_STREAMING_FALLBACK=1
# Workflow generation shares one wall-clock budget across initial + repair calls.
# NZ_WORKFLOW_GENERATION_TIMEOUT_SEC=120
# Optional fallback for image attachments when the active model has no vision.
# The provider uses that provider family's existing credential/base URL settings.
# NZ_IMAGE_DESCRIBE_PROVIDER=openai
# NZ_IMAGE_DESCRIBE_MODEL=gpt-4o-mini
# Use these only when the fallback uses a different account/endpoint.
# NZ_IMAGE_DESCRIBE_API_KEY=
# NZ_IMAGE_DESCRIBE_BASE_URL=https://api.openai.com/v1
# NZ_IMAGE_DESCRIBE_MAX_TOKENS=1200
# models.dev-compatible capability registry. Network refresh is explicit via
# `nz-coder models sync`; normal Agent startup only reads the workspace cache.
# NZ_MODEL_REGISTRY_URL=https://models.dev/api.json
# NZ_MODEL_REGISTRY_PATH=.nz-coder/models/registry.json
# NZ_MODEL_REGISTRY_TTL_SECONDS=300

# Native OpenAI Responses API (MODEL_PROVIDER=openai-responses or codex)
# OPENAI_API_KEY=
# OPENAI_API_BASE_URL=https://api.openai.com/v1

# 可选：为私有/代理模型覆盖自动识别的能力。未设置时按 MODEL_ID family 推断。
# 支持字段见 nz_coder/providers/capabilities.py；MAX_CONTEXT_TOKENS 和
# MAX_OUTPUT_TOKENS 仍可单独覆盖窗口与输出上限。
# MODEL_CAPABILITIES_JSON={"family":"custom","prompt_family":"default","supports_reasoning":true}

# Local MCP stdio servers are disabled unless explicitly enabled. Commands are
# argv arrays (never shell strings), cwd must stay inside the active workspace,
# and undeclared tool effects default to "serial" and require approval.
# NZ_MCP_ENABLED=1
# Layered files: user config, then project config, then NZ_MCP_SERVERS_JSON.
# NZ_MCP_USER_CONFIG=/home/you/.config/nz-coder/mcp.json
# NZ_MCP_PROJECT_CONFIG=.nz-coder/mcp.json
# NZ_MCP_TRUST_STORE=/home/you/.config/nz-coder/mcp-trust.json
# NZ_MCP_SERVERS_JSON={"servers":{"local":{"command":["python3","tools/mcp_server.py"],"cwd":".","tool_effects":{"search":"read","update":"write"}}}}
# Remote Streamable HTTP requires HTTPS. For credentials, store the complete
# header value in an environment variable instead of inline JSON:
# NZ_REMOTE_MCP_AUTH=Bearer replace-me
# NZ_MCP_SERVERS_JSON={"servers":{"remote":{"type":"remote","url":"https://mcp.example.com/mcp","oauth":false,"header_env":{"Authorization":"NZ_REMOTE_MCP_AUTH"},"tool_effects":{"search":"read"}}}}
# OAuth is auto-detected for remote records unless oauth=false. Optional
# pre-registered client config keeps secrets in an environment variable:
# NZ_REMOTE_MCP_CLIENT_SECRET=replace-me
# NZ_MCP_SERVERS_JSON={"servers":{"remote":{"type":"remote","url":"https://mcp.example.com/mcp","oauth":{"client_id":"registered-client","client_secret_env":"NZ_REMOTE_MCP_CLIENT_SECRET","scope":"tools.read"}}}}
# Run: nz-coder mcp auth remote
#      nz-coder mcp status remote
#      nz-coder mcp logout remote
#      nz-coder mcp smoke remote --confirm-live
# Credential storage defaults to ~/.nz-coder/oauth/mcp-auth.json (0600).
# NZ_MCP_AUTH_STORE=/absolute/private/path/mcp-auth.json
# NZ_MCP_STARTUP_TIMEOUT_SECONDS=30
# NZ_MCP_TOOL_TIMEOUT_SECONDS=30

# 使用原生 Anthropic 时可单独配置（否则复用 API_KEY）
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_API_BASE_URL=https://api.anthropic.com
# ANTHROPIC_API_VERSION=2023-06-01

# 使用原生 Gemini 时可单独配置（否则复用 API_KEY）
# GEMINI_API_KEY=xxx
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ============================================================
# 其他兼容的模型提供商
# ============================================================

# DeepSeek
# API_BASE_URL=https://api.deepseek.com/v1
# MODEL_ID=deepseek-v4-flash
# API_KEY=sk-xxx

# OpenAI
# API_BASE_URL=https://api.openai.com/v1
# MODEL_ID=gpt-4o
# API_KEY=sk-xxx

# Anthropic (via OpenAI 兼容层)
# API_BASE_URL=https://api.anthropic.com/v1
# MODEL_ID=claude-sonnet-4-20250514
# API_KEY=sk-ant-xxx

# ============================================================
# 可选配置
# ============================================================

# 权限模式: default / auto / plan / acceptEdits
# PERMISSION_MODE=default

# 可选本地 HTTP Session service 的 Bearer token（至少 16 字符）。
# 未设置时 `nz-coder serve` 每次启动会生成并打印一个随机 token。
# NZ_HTTP_TOKEN=replace-with-a-long-random-secret

# 模型上下文窗口及每轮最大输出；输入预算会自动扣除输出预留
# MAX_CONTEXT_TOKENS=100000
# MAX_OUTPUT_TOKENS=8000

# 日志级别: DEBUG / INFO / WARNING / ERROR
# LOG_LEVEL=INFO

# Bash 单次命令超时秒数
# BASH_TIMEOUT_SECONDS=120
# Persistent processes use a bounded per-workspace service and byte cursors.
# NZ_PROCESS_BUFFER_BYTES=2097152
# NZ_PROCESS_READ_MAX_BYTES=65536
# NZ_PROCESS_WRITE_MAX_BYTES=65536
# NZ_PROCESS_MAX_PER_WORKSPACE=16
# NZ_PROCESS_KILL_GRACE_SECONDS=0.5
# Optional legacy code page used after BOM and UTF-8 decoding fail (for example
# cp936 on a Chinese Windows host). The system encoding remains the next fallback.
# NZ_PROCESS_OUTPUT_ENCODING=cp936

# Public web discovery used before webfetch when no URL is known. The default
# uses no-key Bing RSS and routes explicit GitHub issue queries to GitHub search.
# Values: auto / bing-rss / duckduckgo-html / github-issues / off
# NZ_CODER_WEB_SEARCH_PROVIDER=auto

# 连续相同工具调用达到此次数时阻断；设为 0 可关闭
# NZ_DOOM_LOOP_THRESHOLD=3
# InfCode-compatible default: a rejected permission stops the current Agent turn.
# Set to 1 only if the model should receive the denial and continue automatically.
# NZ_CONTINUE_LOOP_ON_DENY=0

# LSP 默认启用但仅在调用时启动；不会自动下载语言服务器
# NZ_LSP_ENABLED=1
# NZ_LSP_INITIALIZE_TIMEOUT_SECONDS=20
# NZ_LSP_REQUEST_TIMEOUT_SECONDS=10
# NZ_LSP_DIAGNOSTIC_WAIT_SECONDS=2
# 写工具事务提交后，自动把改动文件同步给 LSP 并返回诊断
# NZ_LSP_WRITE_DIAGNOSTICS_ENABLED=1
# NZ_LSP_WRITE_DIAGNOSTIC_MAX_FILES=8
# 可按语言覆盖命令，例如：
# NZ_LSP_PYTHON_COMMAND=pyright-langserver --stdio
# NZ_LSP_TYPESCRIPT_COMMAND=typescript-language-server --stdio

# Python AST Repo Map limits
# NZ_REPO_MAP_MAX_FILES=80
# NZ_REPO_MAP_MAX_SYMBOLS=600
# NZ_REPO_MAP_MAX_FILE_BYTES=1000000

# 默认禁止 agent 在 bash 中安装依赖，避免评测污染宿主环境
# ALLOW_BASH_PACKAGE_INSTALLS=0

# task 子 agent 的独立预算，避免一次探索吃完整个 SWE 实例时间
# SUBAGENT_MAX_TURNS=12
# Optional semantic child tiers. Unconfigured tiers inherit the parent model.
# SUBAGENT_EXPLORE_MODEL=
# SUBAGENT_DEEP_MODEL=
# SUBAGENT_TIMEOUT_SECONDS=180
# SUBAGENT_BACKGROUND_MAX_TASKS=20
# SUBAGENT_BACKGROUND_MAX_CONCURRENT=4
# Consecutive explicit read tools/tasks; serial and write effects remain barriers.
# MAX_PARALLEL_TASKS=4
