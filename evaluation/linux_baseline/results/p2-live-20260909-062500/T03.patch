@@ -0,0 +1,34 @@
+"""Deterministic top_words ordering tests."""
+from textkit.stats import top_words
+
+
+def test_frequency_descending():
+    result = top_words("b b b a a c")
+    assert [word for word, _ in result] == ["b", "a", "c"]
+    assert [count for _, count in result] == [3, 2, 1]
+
+
+def test_ties_broken_alphabetically():
+    # "zebra" and "apple" both occur twice: apple must come first.
+    assert top_words("zebra zebra apple apple")[0] == ("apple", 2)
+    words = [word for word, _ in top_words("dog cat bird dog cat", limit=2)]
+    assert words == ["cat", "dog"]
+
+
+def test_case_insensitive_and_deterministic():
+    # Mixed case collapses to the same tokens, so ties resolve on the
+    # lowercased word in alphabetical order.
+    result = top_words("Zebra APPLE apple zebra")
+    assert result == [("apple", 2), ("zebra", 2)]
+
+
+def test_limit_preserved():
+    assert len(top_words("x a x b x c", limit=2)) == 2
+    assert top_words("x a x b x c", limit=2) == [("x", 3), ("a", 1)]
+
+
+def test_default_limit_three():
+    result = top_words("one one two two three three four four five five")
+    assert len(result) == 3
+    counts = [count for _, count in result]
+    assert counts == sorted(counts, reverse=True)
