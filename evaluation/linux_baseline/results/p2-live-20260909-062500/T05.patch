index 0000000000000000000000000000000000000000..761e96bcec266cdfd54a6ad8b964ff83edf79f1c
--- /dev/null
+++ b/tests/test_lower.py
@@ -0,0 +1,21 @@
+"""Acceptance tests: lower option through library and CLI."""
+import io
+from textkit.cli import main
+from textkit.pipeline import normalize_lines
+
+def test_normalize_lines_lower():
+    assert normalize_lines([" Hello   World "], lower=True) == ["hello world"]
+
+def test_normalize_lines_default_retains_case():
+    assert normalize_lines([" Hello   World "]) == ["Hello World"]
+
+def run_cli(argv, text):
+    stream = io.StringIO()
+    main(argv=argv, stdin=io.StringIO(text), stdout=stream)
+    return stream.getvalue()
+
+def test_cli_lower():
+    assert run_cli(["--lower"], "  Hello   World  \n") == "hello world\n"
+
+def test_cli_default_retains_case():
+    assert run_cli([], "  Hello   World  \n") == "Hello World\n"
