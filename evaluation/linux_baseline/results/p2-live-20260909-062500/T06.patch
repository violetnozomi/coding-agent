@@ -0,0 +1,69 @@
+"""Acceptance tests: archived-aware selection in store and CLI."""
+import io
+import json
+from decimal import Decimal
+
+from worklog.models import Entry
+from worklog.store import select
+from worklog.cli import main
+
+ACTIVE = Entry("a", Decimal("2"))
+ARCHIVED = Entry("z", Decimal("7"), archived=True)
+ACTIVE2 = Entry("b", Decimal("3"))
+
+
+def test_store_default_excludes_archived_preserving_order():
+    entries = [ACTIVE, ARCHIVED, ACTIVE2, Entry("c", Decimal("1"), archived=True)]
+    assert select(entries) == [ACTIVE, ACTIVE2]
+
+
+def test_store_include_archived_returns_all_in_order():
+    entries = [ACTIVE, ARCHIVED, ACTIVE2]
+    assert select(entries, include_archived=True) == entries
+
+
+def test_store_include_archived_is_not_mutating():
+    entries = [ACTIVE, ARCHIVED, ACTIVE2]
+    before = list(entries)
+    selected = select(entries, include_archived=True)
+    assert selected is not entries
+    assert selected == entries == before
+
+
+def test_store_default_does_not_mutate_input():
+    entries = [ACTIVE, ARCHIVED, ACTIVE2]
+    before = list(entries)
+    select(entries)
+    assert entries == before
+    assert [e.archived for e in entries] == [e.archived for e in before]
+
+
+def test_store_accepts_any_iterable_without_reordering():
+    selected = select((ACTIVE2, ARCHIVED, ACTIVE), include_archived=True)
+    assert selected == [ACTIVE2, ARCHIVED, ACTIVE]
+    selected_default = select((ARCHIVED, ACTIVE2, ARCHIVED))
+    assert selected_default == [ACTIVE2]
+
+
+def cli_run(argv, payload):
+    out = io.StringIO()
+    main(argv, io.StringIO(payload), out)
+    return json.loads(out.getvalue())
+
+
+PAYLOAD = json.dumps([
+    {"title": "a", "hours": "2"},
+    {"title": "z", "hours": "7", "archived": True},
+    {"title": "b", "hours": "3"},
+    {"title": "c", "hours": "1", "archived": True},
+])
+
+
+def test_cli_default_excludes_archived_in_order():
+    titles = [row["title"] for row in cli_run([], PAYLOAD)]
+    assert titles == ["a", "b"]
+
+
+def test_cli_include_archived_flag_lists_archived_in_order():
+    titles = [row["title"] for row in cli_run(["--include-archived"], PAYLOAD)]
+    assert titles == ["a", "z", "b", "c"]
