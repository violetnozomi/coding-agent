+"""Tests for textkit.slug.slugify."""
+
+import pytest
+
+from textkit import slugify
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        # Plain lowercasing.
+        ("Hello World", "hello-world"),
+        ("Hello, World!", "hello-world"),
+        # Unicode letters are lowercased and kept.
+        ("Héllo Wörld", "héllo-wörld"),
+        ("ÉLÉPHANT", "éléphant"),
+        # Punctuation is removed except hyphens.
+        ("Don't stop", "dont-stop"),
+        ("Hello (world) [again] {maybe}", "hello-world-again-maybe"),
+        ("price: $19.99", "price-1999"),
+        # Hyphen runs collapse like whitespace.
+        ("Hello--World", "hello-world"),
+        ("Hello - World", "hello-world"),
+        ("Hello -  - World", "hello-world"),
+        # Whitespace runs collapse into one hyphen.
+        ("a   b", "a-b"),
+        ("a\tb\nc", "a-b-c"),
+        # Leading/trailing hyphens and whitespace are stripped.
+        ("-hello-", "hello"),
+        ("  hello  ", "hello"),
+        (" --hello-- ", "hello"),
+        # Mixed case.
+        ("  Hello,  -Wörld!!  ", "hello-wörld"),
+        # Empty or punctuation-only input.
+        ("", ""),
+        ("!!!", ""),
+        ("---", ""),
+        ("  ,.;'\"  ", ""),
+    ],
+)
+def test_slugify(text, expected):
+    assert slugify(text) == expected
