@@ -0,0 +1,20 @@
+"""Slug generation helpers."""
+
+import re
+
+_PUNCTUATION = re.compile(r"[^\w\s-]+")
+_SEPARATOR_RUN = re.compile(r"[\s-]+")
+
+
+def slugify(text: str) -> str:
+    """Turn *text* into a URL-friendly slug.
+
+    Unicode letters are lowercased, punctuation (other than hyphens) is
+    removed, and runs of whitespace or hyphens collapse into a single
+    hyphen. Leading and trailing hyphens are stripped. Empty or
+    punctuation-only input yields an empty string.
+    """
+    lowered = text.lower()
+    no_punctuation = _PUNCTUATION.sub("", lowered)
+    collapsed = _SEPARATOR_RUN.sub("-", no_punctuation)
+    return collapsed.strip("-")
