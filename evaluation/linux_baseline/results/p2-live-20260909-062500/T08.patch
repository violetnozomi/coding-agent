@@ -0,0 +1,70 @@
+"""Acceptance tests: project totals, --summary CLI, legacy project input."""
+import io
+import json
+from decimal import Decimal
+
+from worklog.cli import main
+from worklog.codec import dumps, loads
+from worklog.models import Entry
+from worklog.reports import project_totals
+
+
+def test_project_totals_groups_and_is_exact():
+    entries = [
+        Entry("a", Decimal("0.1"), project="alpha"),
+        Entry("b", Decimal("0.2"), project="alpha"),
+        Entry("c", Decimal("1.5"), project="beta"),
+    ]
+    totals = project_totals(entries)
+    assert totals == {"alpha": Decimal("0.3"), "beta": Decimal("1.5")}
+    assert totals["alpha"] == Decimal("0.3")  # exact; no binary float drift
+
+
+def test_project_totals_legacy_empty_project():
+    entries = [Entry("a", Decimal("1")), Entry("b", Decimal("2.5"))]
+    assert project_totals(entries) == {"": Decimal("3.5")}
+
+
+def test_codec_parses_project_and_defaults_legacy_missing():
+    assert loads('[{"title": "x", "hours": "1", "project": "p"}]') == [
+        Entry("x", Decimal("1"), project="p")
+    ]
+    assert loads('[{"title": "x", "hours": "1"}]') == [
+        Entry("x", Decimal("1"), project="")
+    ]
+    entry = Entry("x", Decimal("1.5"), project="p")
+    assert loads(dumps([entry])) == [entry]
+
+
+def test_summary_outputs_project_to_decimal_string():
+    data = json.dumps([
+        {"title": "a", "hours": "0.1", "project": "alpha"},
+        {"title": "b", "hours": "0.2", "project": "alpha"},
+        {"title": "c", "hours": "1.5"},
+    ])
+    out = io.StringIO()
+    main(["--summary"], io.StringIO(data), out)
+    assert json.loads(out.getvalue()) == {"alpha": "0.3", "": "1.5"}
+
+
+def test_summary_filters_archived_by_default_and_includes_with_flag():
+    data = json.dumps([
+        {"title": "a", "hours": "1", "project": "alpha"},
+        {"title": "b", "hours": "9", "project": "alpha", "archived": True},
+    ])
+    out = io.StringIO()
+    main(["--summary"], io.StringIO(data), out)
+    assert json.loads(out.getvalue()) == {"alpha": "1"}
+    out = io.StringIO()
+    main(["--summary", "--include-archived"], io.StringIO(data), out)
+    assert json.loads(out.getvalue()) == {"alpha": "10"}
+
+
+def test_default_list_output_preserved():
+    data = json.dumps([
+        {"title": "a", "hours": "2", "project": "alpha"},
+        {"title": "gone", "hours": "3", "project": "beta", "archived": True},
+    ])
+    out = io.StringIO()
+    main([], io.StringIO(data), out)
+    assert json.loads(out.getvalue()) == [{"title": "a", "hours": "2"}]
