 def average_hours(entries):
     values = list(entries)
     return total_hours(values) / len(values)
+
+def project_totals(entries):
+    totals = {}
+    for entry in entries:
+        totals[entry.project] = totals.get(entry.project, Decimal(0)) + entry.hours
+    return totals
