@@ -0,0 +1,36 @@
+"""Target acceptance tests: project preserved through codec and CLI."""
+import io
+import json
+from decimal import Decimal
+from worklog.models import Entry
+from worklog.codec import dumps, loads
+from worklog.cli import main
+
+def test_roundtrip_preserves_project_unicode():
+    entries = [Entry("документ", Decimal("2.5"), project="Роскосмос/Проект-α")]
+    assert loads(dumps(entries)) == entries
+
+def test_dumps_includes_project_field():
+    raw = json.loads(dumps([Entry("t", Decimal("1"), project="acme")]))
+    assert raw == [{"title": "t", "hours": "1",
+                    "project": "acme", "archived": False}]
+
+def test_old_row_without_project_loads_as_empty():
+    (loaded,) = loads('[{"title":"legacy","hours":"1"}]')
+    assert loaded == Entry("legacy", Decimal("1"))
+    assert loaded.project == ""
+
+def test_cli_default_output_includes_project_unicode():
+    out = io.StringIO()
+    main([], io.StringIO('[{"title":"бета","hours":"3","project":"Гамма"}]'), out)
+    (row,) = json.loads(out.getvalue())
+    assert row == {"title": "бета", "hours": "3", "project": "Гамма"}
+
+def test_cli_default_keeps_title_hours_and_archive_filtering():
+    out = io.StringIO()
+    data = ('[{"title":"b","hours":"4","project":"p1"},'
+            '{"title":"x","hours":"9","project":"p2","archived":true}]')
+    main([], io.StringIO(data), out)
+    rows = json.loads(out.getvalue())
+    assert len(rows) == 1
+    assert rows[0] == {"title": "b", "hours": "4", "project": "p1"}
