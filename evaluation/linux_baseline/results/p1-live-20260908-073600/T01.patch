--- a/tests/test_public.py
+++ b/tests/test_public.py
@@ -7,6 +7,16 @@ from textkit.io import save_lines
 def test_parse():
     assert parse_items(" a, b ") == ["a", "b"]
 
+def test_parse_empty_or_whitespace():
+    assert parse_items("") == []
+    assert parse_items("   ") == []
+    assert parse_items("\t\n ") == []
+
+def test_parse_preserves_order_trim_and_empty_fields():
+    assert parse_items(" c , a , b ") == ["c", "a", "b"]
+    assert parse_items("a,,b") == ["a", "", "b"]
+    assert parse_items(" a, ,b ,") == ["a", "", "b", ""]
+
 def test_normalize():
     assert normalize_lines([" Hello   World "]) == ["Hello World"]
 
