+                    json.dumps(
+                        original.to_dict()
+                        if checkpoint == "retained"
+                        else {"active": True, "initial_task_text": TASK}
+                    )
+                )
+            lifecycle.lifecycle_context_from_legacy_host(env).prepare_runtime_state(
+                TASK, 12, 0, True, ""
+            )
+            refs = env.runtime_state.task_reference_evidence
+            if checkpoint == "retained":
