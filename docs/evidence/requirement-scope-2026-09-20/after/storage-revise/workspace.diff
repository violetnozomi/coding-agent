+def test_snapshot_data_is_independent(tmp_path):
+    path = tmp_path / "s.json"
+    store.save(path, {"a": 1})
+    snap = store.load_snapshot(path)
+    snap.data["a"] = 99
+    assert store.load(path) == {"a": 1}
