+def total_by_category(rows: list[dict[str, str]]) -> dict[str, Decimal]:
+    """Sum amounts per category, keyed by stripped category name.
+
+    Leading/trailing whitespace is removed and blank categories are grouped
+    under the label "未分类".
+    """
+    totals: dict[str, Decimal] = {}
+    for row in rows:
+        category = row["category"].strip() or "未分类"
+        totals[category] = totals.get(category, Decimal("0")) + Decimal(row["amount"])
+    return totals
