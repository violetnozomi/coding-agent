@@ -0,0 +1,97 @@
+"""End-to-end CLI tests for the --by-category report."""
+from __future__ import annotations
+
+import csv
+import io
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+
+def run_cli(*args: str) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(
+        [sys.executable, "-m", "expensebook", *args],
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+
+
+def parse_csv(text: str) -> list[list[str]]:
+    return list(csv.reader(io.StringIO(text)))
+
+
+class ByCategoryCliTests(unittest.TestCase):
+    def write_csv(self, content: str, name: str = "expenses.csv") -> str:
+        self._tmpdir = tempfile.TemporaryDirectory()
+        self.addCleanup(self._tmpdir.cleanup)
+        path = Path(self._tmpdir.name) / name
+        path.write_text(content, encoding="utf-8")
+        return str(path)
+
+    def test_groups_strips_and_sorts_ascending(self):
+        path = self.write_csv(
+            "category,amount\n"
+            " food ,0.10\n"
+            "food,0.20\n"
+            "  \n-1.00\n"
+            "drinks,2.00\n"
+        )
+        result = run_cli(path, "--by-category")
+        self.assertEqual(
+            parse_csv(result.stdout),
+            [
+                ["category", "total"],
+                ["drinks", "2.00"],
+                ["food", "0.30"],
+                ["未分类", "-1.00"],
+            ],
+        )
+
+    def test_decimal_exactness_and_two_decimals(self):
+        path = self.write_csv("category,amount\na,0.10\na,0.20\nb,0.10\nb,0.10\nb,0.10\n")
+        result = run_cli(path, "--by-category")
+        self.assertEqual(
+            parse_csv(result.stdout),
+            [["category", "total"], ["a", "0.30"], ["b", "0.30"]],
+        )
+
+    def test_chinese_categories(self):
+        path = self.write_csv("category,amount\n餐饮,12.34\n交通,5.50\n餐饮,0.01\n")
+        result = run_cli(path, "--by-category")
+        self.assertEqual(
+            parse_csv(result.stdout),
+            [["category", "total"], ["交通", "5.50"], ["餐饮", "12.35"]],
+        )
+
+    def test_category_with_comma(self):
+        path = self.write_csv('category,amount\n"food, snacks",1.50\nother,2.00\n')
+        result = run_cli(path, "--by-category")
+        self.assertEqual(
+            parse_csv(result.stdout),
+            [["category", "total"], ["food, snacks", "1.50"], ["other", "2.00"]],
+        )
+
+    def test_path_with_spaces(self):
+        path = self.write_csv("category,amount\na,1.00\n", name="my expenses.csv")
+        result = run_cli(path, "--by-category")
+        self.assertEqual(
+            parse_csv(result.stdout),
+            [["category", "total"], ["a", "1.00"]],
+        )
+
+    def test_header_only_empty_file(self):
+        path = self.write_csv("category,amount\n")
+        result = run_cli(path, "--by-category")
+        self.assertEqual(parse_csv(result.stdout), [["category", "total"]])
+
+    def test_default_total_unchanged(self):
+        path = self.write_csv("category,amount\na,0.10\nb,0.20\n")
+        result = run_cli(path)
+        self.assertEqual(result.stdout, "0.30\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
