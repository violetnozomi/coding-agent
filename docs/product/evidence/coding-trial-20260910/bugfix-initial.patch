@@ -0,0 +1,11 @@
+"""Existing configuration merge behavior."""
+import unittest
+from layered_settings import merge_settings
+
+
+class MergeTests(unittest.TestCase):
+    def test_scalar_override(self):
+        self.assertEqual(merge_settings({"port": 80}, {"port": 443}), {"port": 443})
+
+    def test_new_key(self):
+        self.assertEqual(merge_settings({"a": 1}, {"b": 2}), {"a": 1, "b": 2})
