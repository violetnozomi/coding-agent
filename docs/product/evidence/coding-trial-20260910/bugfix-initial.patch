+"""Print the combined configuration as JSON."""
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+from .merge import merge_settings
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description="Merge JSON configuration layers")
+    parser.add_argument("base")
+    parser.add_argument("override")
+    args = parser.parse_args()
+    base = json.loads(Path(args.base).read_text(encoding="utf-8"))
+    override = json.loads(Path(args.override).read_text(encoding="utf-8"))
+    print(json.dumps(merge_settings(base, override), ensure_ascii=False, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
