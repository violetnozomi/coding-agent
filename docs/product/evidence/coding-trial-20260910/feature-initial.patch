+"""Command-line entry point for expense totals."""
+from __future__ import annotations
+
+import argparse
+from .report import read_expenses, total_amount
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description="Report CSV expenses")
+    parser.add_argument("csv_path")
+    args = parser.parse_args()
+    print(f"{total_amount(read_expenses(args.csv_path)):.2f}")
+
+
+if __name__ == "__main__":
+    main()
