+"""Existing total-report regression tests."""
+from decimal import Decimal
+import unittest
+from expensebook.report import total_amount
+
+
+class TotalTests(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(total_amount([]), Decimal("0"))
+
+    def test_decimal_total(self):
+        self.assertEqual(total_amount([{"amount": "0.10"}, {"amount": "0.20"}]), Decimal("0.30"))
